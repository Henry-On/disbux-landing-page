RewriteEngine On 

# Voucher claim links: the app shares /user/redeem?claimCode=XXX as a universal
# link. When the app isn't installed the browser lands here instead, so serve
# the claim page (code copying + open-app/store redirect) at the same URL.
RewriteRule ^user/redeem/?$ claim.html [L,QSA]

# Force HTTPS
#RewriteCond %{HTTPS} off 
#RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Skip rewriting if it's a real file or folder
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f

# Serve .html or .php files without extension
RewriteCond %{REQUEST_FILENAME}.html -f [OR]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.html [L]

# Security hardening
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deny direct access to dotfiles such as /.git/ (/.well-known/ app-link
# files are unaffected: FilesMatch only matches file names, not paths)
<IfModule mod_authz_core.c>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>

ErrorDocument 404 https://disbux.com

#ENV
setEnv INTERNAL_PROXY_KEY ca66b4e75d6722c5d73480e27d309f6478465935d07c9a7f1a9b3f04ea87f9a1
setEnv BACKEND_API_URL https://disbux-production.up.railway.app/api